// settings.user.example.jsonc - example USER-level Claude Code settings.
// Purpose: store a key outside any repo and keep unattended runs on a short leash.
// Install: remove all // comment lines (JSON does not allow comments), save as ~/.claude/settings.json,
//          then: chmod 600 ~/.claude/settings.json
// Never put credentials in a project's committed .claude/settings.json.
// Permission rules: "Bash(npm run test *)" is the current prefix-match form (the older "Bash(npm run test *)" suffix
//          is still accepted as equivalent); Read(./.env) is a gitignore-style path relative to the working directory.
//          See code.claude.com/docs/en/permissions. Edit the commands before use.
{
  "env": {
    "ANTHROPIC_API_KEY": "YOUR_API_KEY"
  },
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
